<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.activities.analytics.AnalyticsActivity">

    <!-- Основное содержимое в ScrollView -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ввод общего бюджета -->
            <EditText
                android:id="@+id/etTotalBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Введите общий бюджет поездки"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Рассчитать аналитику" />

            <!-- Общая статистика -->
            <TextView
                android:id="@+id/tvTotalSpent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Потрачено:"
                android:textSize="18sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvRemainingBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Осталось:"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <!-- Общий столбчатый график: распределение расходов по категориям -->
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/overallBarChart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="24dp" />

            <!-- RecyclerView для динамически добавляемых элементов аналитики категорий -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Кнопка "Назад" в левом нижнем углу -->
    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@drawable/round_icon_button"
        android:src="@drawable/ic_back"
        android:scaleType="centerInside"
        android:contentDescription="@string/back_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
