<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9BDDFF"
    tools:context=".view.activities.main.MainPageActivity">

    <!-- ВЕРХНЯЯ ШАПКА (аватар, имя, дата, настройки) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/main_page_account_settings_frame"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imageView_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginVertical="8dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/user_default_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:civ_border_width="0dp"/>

        <!-- Имя аккаунта -->
        <TextView
            android:id="@+id/main_page_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textAppearance="@style/AccountInfoStyle"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/imageView_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5"/>

        <!-- Текущая дата -->
        <TextView
            android:id="@+id/main_page_settings_current_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/AccountInfoStyle"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/calendar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- Иконка настроек -->
        <ImageView
            android:id="@+id/calendar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginVertical="8dp"
            app:srcCompat="@drawable/ic_calendar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- БЛОК: ГОРОД И ПОГОДА -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weather_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/main_page_current_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CurrentCityStyle"
            android:textSize="25sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageView
            android:id="@+id/main_page_weather_icon"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5"
            android:scaleType="fitCenter" />


        <TextView
            android:id="@+id/main_page_current_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CurrentCityStyle"
            android:textSize="26sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_page_current_city"/>

        <!-- Новое поле для описания погоды -->
        <TextView
            android:id="@+id/main_page_weather_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CurrentCityStyle"
            android:textSize="18sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_page_current_temperature"/>

        <!-- Дополнительно можно добавить параметры, например давление и влажность -->
        <TextView
            android:id="@+id/main_page_weather_pressure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CurrentCityStyle"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_page_weather_description"/>

        <TextView
            android:id="@+id/main_page_weather_humidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CurrentCityStyle"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_page_weather_pressure"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ТРИ ВОЛНЫ: все равной высоты -->
    <!-- ================= WAVE1 ================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wave1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/main_page_my_journeys_frame"
        app:layout_constraintTop_toBottomOf="@+id/weather_block"
        app:layout_constraintBottom_toTopOf="@+id/wave2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintVertical_weight="1">

        <!-- Иконка -->
        <ImageView
            android:id="@+id/wave1_icon"
            android:layout_width="146dp"
            android:layout_height="104dp"
            android:src="@drawable/main_page_paper_plane_image"
            app:layout_constraintBottom_toTopOf="@id/wave1_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Текст под иконкой -->
        <TextView
            android:id="@+id/wave1_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_page_my_journeys_text"
            android:textAppearance="@style/CurrentCityStyle"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/wave1_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= WAVE2 ================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wave2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/main_page_journey_diary_frame"
        app:layout_constraintTop_toBottomOf="@+id/wave1"
        app:layout_constraintBottom_toTopOf="@+id/wave3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1">

        <!-- Иконка -->
        <ImageView
            android:id="@+id/wave2_icon"
            android:layout_width="146dp"
            android:layout_height="104dp"
            android:src="@drawable/main_page_diary_book_image"
            app:layout_constraintBottom_toTopOf="@id/wave2_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Текст под иконкой -->
        <TextView
            android:id="@+id/wave2_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_page_journey_diary_text"
            android:textAppearance="@style/CurrentCityStyle"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/wave2_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= WAVE3 ================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wave3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/main_page_go_on_a_journey_frame"
        app:layout_constraintTop_toBottomOf="@+id/wave2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1">

        <!-- Иконка -->
        <ImageView
            android:id="@+id/wave3_icon"
            android:layout_width="146dp"
            android:layout_height="104dp"
            android:src="@drawable/main_page_map_with_location_marker_image"
            app:layout_constraintBottom_toTopOf="@id/wave3_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Текст под иконкой -->
        <TextView
            android:id="@+id/wave3_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_page_go_on_a_journey_text"
            android:textAppearance="@style/CurrentCityStyle"
            android:textSize="25sp"
            android:textColor="@android:color/black"
            app:layout_constraintTop_toBottomOf="@id/wave3_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
