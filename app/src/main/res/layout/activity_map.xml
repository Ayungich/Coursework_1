<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.activities.MapActivity">

    <!-- Верхний контейнер с кнопками в ряд, с заданным фоном -->
    <LinearLayout
        android:id="@+id/top_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/main_page_account_settings_frame"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ImageButton для добавления метки -->
        <ImageButton
            android:id="@+id/add_marker_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_ad_marker"
            android:contentDescription="Добавить метку"
            android:layout_marginEnd="16dp"/>

        <!-- ImageButton для прокладывания маршрута -->
        <ImageButton
            android:id="@+id/route_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_route"
            android:contentDescription="Проложить маршрут"
            android:layout_marginEnd="16dp"/>

        <!-- ImageButton для удаления последней метки -->
        <ImageButton
            android:id="@+id/delete_marker_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete_medium"
            android:contentDescription="Удалить метку"/>
    </LinearLayout>

    <!-- MapView для карты Mapbox -->
    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_buttons_container"
        app:layout_constraintBottom_toTopOf="@id/bottom_buttons_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:mapbox_locationComponentEnabled="true"
        app:mapbox_locationComponentPuckBearing="heading"/>

    <!-- Нижний контейнер с кнопками зумирования, с заданным фоном -->
    <LinearLayout
        android:id="@+id/bottom_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/main_page_account_settings_frame"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ImageButton для уменьшения зума -->
        <ImageButton
            android:id="@+id/zoom_out_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_zoom_out"

            android:contentDescription="Zoom Out"
            android:layout_marginEnd="16dp"/>

        <!-- ImageButton для увеличения зума -->
        <ImageButton
            android:id="@+id/zoom_in_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_zoom_in"
            android:contentDescription="Zoom In"/>
    </LinearLayout>

    <!-- Центрирующееся перекрестие на карте -->
    <ImageView
        android:id="@+id/center_cross"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_add"
        app:layout_constraintTop_toTopOf="@id/mapView"
        app:layout_constraintBottom_toBottomOf="@id/mapView"
        app:layout_constraintStart_toStartOf="@id/mapView"
        app:layout_constraintEnd_toEndOf="@id/mapView" />

    <!-- Кнопка "Назад" в левом нижнем углу -->
    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@drawable/round_icon_button"
        android:src="@drawable/ic_back"
        android:scaleType="centerInside"
        android:contentDescription="@string/back_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
