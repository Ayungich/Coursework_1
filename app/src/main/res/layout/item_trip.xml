<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@drawable/profile_field_frame">

    <!-- Контейнер для кнопок (справа) -->
    <LinearLayout
        android:id="@+id/right_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_analytics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/budget"
            app:srcCompat="@drawable/ic_analytics" />

        <ImageButton
            android:id="@+id/btn_budget"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/budget"
            app:srcCompat="@drawable/ic_budget" />

        <ImageButton
            android:id="@+id/btn_route"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/route_planning"
            app:srcCompat="@drawable/ic_route" />

        <ImageButton
            android:id="@+id/btn_packing"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/packing_list"
            app:srcCompat="@drawable/ic_packing" />

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_delete" />
    </LinearLayout>

    <!-- Название путешествия -->
    <TextView
        android:id="@+id/trip_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Trip Title"
        android:textAppearance="@style/AccountInfoStyle"
        android:textColor="#000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/right_buttons_container"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp"/>

    <!-- Даты путешествия (startDate - endDate) -->
    <TextView
        android:id="@+id/trip_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textAppearance="@style/AccountInfoStyle"
        android:textSize="12sp"
        android:textColor="#666"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/trip_title"
        app:layout_constraintStart_toStartOf="@id/trip_title"
        app:layout_constraintEnd_toEndOf="@id/trip_title"/>

    <!-- Даты путешествия (startDate - endDate) -->
    <TextView
        android:id="@+id/trip_dates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textAppearance="@style/AccountInfoStyle"
        android:textSize="12sp"
        android:textColor="#666"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/trip_type"
        app:layout_constraintStart_toStartOf="@id/trip_type"
        app:layout_constraintEnd_toEndOf="@id/trip_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
